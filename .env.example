# App
NODE_ENV=development
APP_URL=https://jaffer-brother-group-it.vercel.app
APP_BASE_URL=https://jaffer-brother-group-it.vercel.app

# MySQL (must have SELECT on connection.employees when using HR sync)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=connection
MYSQL_USER=connection_usr
MYSQL_PASSWORD=change-me

# Seeded admin user (created/updated on startup+migrate)
ADMIN_NAME=GIT Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Demo password logins — kept off in production intent (SSO primary).
# Password form remains available as emergency fallback until SSO is verified.
DEMO_LOGIN=0

# SMTP / comment notifications
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=edc@jaffer.com
SMTP_PASS=your-smtp-password
SMTP_FROM=edc@jaffer.com

# Azure AD / Entra ID SSO — see also azure.env.example
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
AZURE_TENANT_ID=organizations
AZURE_SCOPES=openid profile email offline_access https://graph.microsoft.com/User.Read
AZURE_REDIRECT_URI=https://jaffer-brother-group-it.vercel.app/auth/azure/callback
AZURE_ALLOWED_DOMAINS=*
AZURE_SSO_AUTO_PROVISION=0
