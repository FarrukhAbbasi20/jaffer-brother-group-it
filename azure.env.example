# Azure AD / Entra ID SSO — set these on Vercel (Project → Settings → Environment Variables)
# Do NOT commit real secrets.

AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
# Use "organizations" (work/school, multi-tenant) or "common" (also personal Microsoft accounts).
# Do NOT use a single-tenant GUID if users sign in from multiple Azure tenants.
AZURE_TENANT_ID=organizations
AZURE_SCOPES=openid profile email offline_access https://graph.microsoft.com/User.Read

# Must match an Redirect URI registered on the Azure app:
AZURE_REDIRECT_URI=https://jaffer-brother-group-it.vercel.app/auth/azure/callback
APP_BASE_URL=https://jaffer-brother-group-it.vercel.app

# Email domain allowlist (optional).
# Empty / * / any = any Microsoft account that completes SSO.
# Or comma-separated: jaffer.com,jbs.live,contoso.com
AZURE_ALLOWED_DOMAINS=*
# Legacy single-domain var still supported: AZURE_ALLOWED_DOMAIN=jaffer.com

# 1 = create portal user on first Microsoft login (not recommended)
# 0 = only users already added in Users (with access) can sign in
AZURE_SSO_AUTO_PROVISION=0
